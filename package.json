    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@playwright/test": "1.63.0",
    "fake-indexeddb": "6.2.5",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
