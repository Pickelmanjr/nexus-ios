{
  "name": "nexus-ios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Rule34 and Gelbooru browser for iPhone, built from the Nexus interface.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
